PORT=4173
NODE_ENV=development
FOLIO_DATA_DIR=.data
APP_ORIGIN=http://localhost:4173

# Google Cloud Console OAuth 2.0 Web Client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4173/api/v1/auth/google/callback

# AI provider (Gemini integration is the production target)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-3.6-flash
GEMINI_EXTRACTION_MODEL=gemini-3.5-flash-lite
GEMINI_WRITING_MODEL=gemini-3.5-flash

# Legacy optional OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# NAS compose settings
FOLIO_DATA_PATH=./nas-data
CLOUDFLARE_TUNNEL_TOKEN=
